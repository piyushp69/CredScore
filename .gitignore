# Data and trained artifacts are regenerated by `python -m credscore.pipeline all`.
# The ~4 MB serving bundle is committed so the deployed dashboard has a model;
# the raw CSVs (up to 690 MB each) exceed GitHub's file size limit.
dataset/*
!dataset/.gitkeep
models/*
!models/.gitkeep
!models/model.ubj
!models/metadata.json
!models/report.json
!models/insights.json

.ipynb_checkpoints/

.streamlit/secrets.toml
